# Valor Operations Hub — web env (example).
#
# Copy this file to apps/web/.env.local and fill in real values to switch the
# data layer from the in-memory MockRepository to Supabase. With NONE of these
# set, the app runs entirely on the mock (the default) and behaves identically.
#
# Real .env* files are gitignored — never commit credentials.

# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
# Exposed to the browser (NEXT_PUBLIC_*). Required to enable the Supabase repo.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (safe for the browser; RLS enforces tenant
# isolation). Required to enable the Supabase repo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The UUID of the org row this deployment operates as — the `id` of the
# public.orgs row you seed for the demo user (see supabase/README.md).
# REQUIRED to enable the Supabase repo: org_id columns are typed `uuid`, so a
# non-UUID value makes PostgREST's org_id filters error or match nothing. There
# is intentionally no fallback — if this is unset the app stays on the mock.
NEXT_PUBLIC_SUPABASE_ORG_ID=
